 } }\n  </style>\n</helmet>\n\n<!-- ═══════════ TOP BAR ═══════════ -->\n<div data-chrome=\"1\" style=\"position: sticky; top: 0; z-index: 100; background: rgba(255,255,255,0.92); backdrop-filter: blur(10px); border-bottom: 1px solid #EAF0FE;\">\n  <div style=\"max-width: 1180px; margin: 0 auto; padding: 16px 48px; display: flex; justify-content: space-between; align-items: center;\">\n    <a href=\"index.html\" style=\"display: flex; align-items: center; gap: 10px; color: #0A1633; font-weight: 700; font-size: 14px;\" style-hover=\"color: #0046FF;\">← 돌아가기</a>\n    <div style=\"display: flex; align-items: center; gap: 10px;\">\n      <img src=\"assets/bear-face.webp\" alt=\"\" style=\"width: 26px; height: auto;\">\n    </div>\n  </div>\n</div>\n\n<!-- ═══════════ HERO ═══════════ -->\n<div data-chrome=\"1\" data-screen-label=\"프로젝트 히어로\" style=\"background: #0046FF; color: #fff; position: relative; overflow: hidden;\">\n  <div style=\"position: absolute; left: 0; right: 0; bottom: -36px; font-size: 260px; font-weight: 800; letter-spacing: -0.04em; line-height: 0.8; color: transparent; -webkit-text-stroke: 1.5px rgba(255,255,255,0.18); white-space: nowrap; user-select: none; pointer-events: none;\">MARKET</div>\n  <div style=\"max-width: 1180px; margin: 0 auto; padding: 72px 48px 88px; position: relative;\">\n\n    <div style=\"display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid rgba(255,255,255,0.22); padding-bottom: 20px;\">\n      <div style=\"display: flex; gap: 28px; font-size: 13px; font-weight: 700; letter-spacing: 0.16em; color: rgba(255,255,255,0.65);\">\n        <span>PROJECT — 02</span>\n        <span>실무 · 분양대행사 인턴</span>\n        <span>기획 · 분석 · 영상 제작</span>\n      </div>\n      <div style=\"font-size: 13px; font-weight: 800; letter-spacing: 0.16em; color: #FFB13D;\">AI 4종 · 데이터 10개 채널</div>\n    </div>\n\n    <div style=\"display: grid; grid-template-columns: 1fr auto; gap: 48px; align-items: end; margin-top: 56px;\">\n      <div>\n        <div style=\"font-size: 76px; font-weight: 800; line-height: 1.08; letter-spacing: -0.02em;\">AI 분양 시장<br>분석 영상</div>\n        <div style=\"font-size: 18px; color: rgba(255,255,255,0.78); margin-top: 26px; line-height: 1.75; max-width: 620px;\">AI 4종과 시장 데이터 10개 채널로 경기 남부 20개 지역을 분석해, 분양 시장을 4개 권역으로 나누고 권역마다 다른 분양 난이도를 한 편의 영상으로 정리했어요.</div>\n      </div>\n      <a href=\"#video\" style=\"display: inline-flex; align-items: center; gap: 10px; background: #fff; color: #0033BB; font-size: 15px; font-weight: 800; padding: 15px 28px; border-radius: 999px; white-space: nowrap; transition: transform 0.2s, box-shadow 0.2s;\" style-hover=\"transform: translateY(-3px); box-shadow: 0 12px 26px rgba(0,10,40,0.35); color: #0033BB;\">영상 보기 ↓</a>\n    </div>\n\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr 1fr; margin-top: 60px; border-top: 1px solid rgba(255,255,255,0.22);\">\n      <div style=\"padding: 20px 28px 0 0; border-right: 1px solid rgba(255,255,255,0.14);\">\n        <div style=\"font-size: 12px; letter-spacing: 0.2em; font-weight: 700; color: rgba(255,255,255,0.5);\">ROLE</div>\n        <div style=\"font-size: 16px; font-weight: 700; margin-top: 8px;\">기획 · 분석 · 영상 제작</div>\n      </div>\n      <div style=\"padding: 20px 28px 0 28px; border-right: 1px solid rgba(255,255,255,0.14);\">\n        <div style=\"font-size: 12px; letter-spacing: 0.2em; font-weight: 700; color: rgba(255,255,255,0.5);\">STACK</div>\n        <div style=\"font-size: 16px; font-weight: 700; margin-top: 8px;\">Claude · ChatGPT · Gemini · NotebookLM</div>\n      </div>\n      <div style=\"padding: 20px 0 0 28px;\">\n        <div style=\"font-size: 12px; letter-spacing: 0.2em; font-weight: 700; color: rgba(255,255,255,0.5);\">OUTPUT</div>\n        <div style=\"font-size: 16px; font-weight: 700; margin-top: 8px;\">권역 분석 영상 (34초)</div>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<!-- ═══════════ 소개 ═══════════ -->\n<div data-screen-label=\"소개\" style=\