tTimeout(fit, 1200); setTimeout(fit, 3000);\n  }\n\n  frame.addEventListener('load', prepare);\n\n  function select(key, push) {\n    var tab = tabs.filter(function (t) { return t.dataset.key === key; })[0] || tabs[0];\n    tabs.forEach(function (t) { t.setAttribute('aria-selected', t === tab ? 'true' : 'false'); });\n    panel.setAttribute('aria-labelledby', tab.id);\n    if (frame.getAttribute('src') !== tab.dataset.src) { frame.style.height = '2400px'; frame.setAttribute('src', tab.dataset.src); }\n    if (push) {\n      history.replaceState(null, '', '#' + tab.dataset.key);\n      var top = document.querySelector('.tabs-bar').offsetTop;\n      if (window.scrollY > top) window.scrollTo({ top: top, behavior: 'smooth' });\n    }\n    if (window.gtag) gtag('event', 'internship_tab', { tab: tab.dataset.key });\n  }\n\n  tabs.forEach(function (t) { t.addEventListener('click', function () { select(t.dataset.key, true); }); });\n  document.querySelector('.tabs').addEventListener('keydown', function (e) {\n    if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;\n    var i = tabs.indexOf(document.activeElement); if (i < 0) return;\n    var n = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];\n    n.focus(); select(n.dataset.key, true);\n  });\n  window.addEventListener('resize', fit);\n  window.addEventListener('hashchange', function () { select((location.hash || '').replace('#', ''), false); });\n  var start = (location.hash || '').replace('#', '');\n  if (start) select(start, false);\n})();\n</script>\n</body>\n</html>\n"]]}},"media":[["assets/market-analysis.mp4","https://raw.githubusercontent.com/manduuu11/photo/portfolio-media/portfolio/market-analysis.mp4","d5b64ad40d23ba75f584d9a47595663e15e0cb12"],["assets/market-analysis.jpg","https://raw.githubusercontent.com/manduuu11/photo/portfolio-media/portfolio/market-analysis.jpg","03070f2736a7996be63950d3e1a4c17c9430a002"]]}